<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="589.0" minWidth="906.0" prefHeight="589.0" prefWidth="906.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vanier.com.programmingpatternslia.App.Controllers.ParticipantsController">
    <BorderPane styleClass="animated-background" stylesheets="@CSS/aniamtedbackground.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <left>
            <fx:include fx:id="sidebar" source="Sidebar.fxml"/>
        </left>
        <center>
            <VBox spacing="18.0">
                <padding>
                    <Insets top="30.0" right="26.0" bottom="22.0" left="26.0"/>
                </padding>
                <Label fx:id="welcomeText" text="Participants" textFill="WHITE">
                    <font>
                        <Font name="Arial Rounded MT Bold" size="24.0"/>
                    </font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <TextField HBox.hgrow="ALWAYS" promptText="Search" maxWidth="Infinity" prefHeight="30.0" style="-fx-background-color: #0F0C0C; -fx-border-color: #C20000; -fx-background-radius: 5; -fx-border-radius: 5; -fx-text-fill: white;"/>
                </HBox>
                <TableView VBox.vgrow="ALWAYS" stylesheets="@CSS/table.css" minHeight="100.0">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn text="Name" prefWidth="120.0"/>
                        <TableColumn text="Email" prefWidth="120.0"/>
                        <TableColumn text="Age" prefWidth="120.0"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button mnemonicParsing="false" prefHeight="32.0" stylesheets="@CSS/stylizedbutton.css" text="Edit"/>
                    <Button mnemonicParsing="false" prefHeight="32.0" stylesheets="@CSS/stylizedbutton.css" text="Delete"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>
