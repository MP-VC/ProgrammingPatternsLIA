<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="589.0" minWidth="906.0" prefHeight="589.0" prefWidth="906.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vanier.com.programmingpatternslia.App.Controllers.MyRegistrationsController">
    <children>
        <BorderPane styleClass="animated-background" stylesheets="@CSS/aniamtedbackground.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <left>
                <fx:include fx:id="sidebar" source="Sidebar.fxml" />
            </left>
            <center>
                <VBox alignment="TOP_LEFT" spacing="18.0">
                    <padding><Insets bottom="22.0" left="26.0" right="26.0" top="30.0" /></padding>
                    <children>
                        <Label fx:id="welcomeText" text="My Registrations" textFill="WHITE"><font><Font name="Arial Rounded MT Bold" size="24.0" /></font>
                     <VBox.margin>
                        <Insets left="10.0" />
                     </VBox.margin>
                     <padding>
                        <Insets top="10.0" />
                     </padding></Label>
                        <TableView minHeight="100.0" stylesheets="@CSS/table.css" VBox.vgrow="ALWAYS">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" /></columnResizePolicy>
                            <columns>
                                <TableColumn prefWidth="120.0" text="Conference" />
                                <TableColumn prefWidth="120.0" text="Start" />
                                <TableColumn prefWidth="120.0" text="End" />
                                <TableColumn prefWidth="120.0" text="Status" />
                            </columns>
                     <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                     </VBox.margin>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Button fx:id="cancelButton" mnemonicParsing="false" prefHeight="32.0" stylesheets="@CSS/stylizedbutton.css" text="Cancel">
                        <HBox.margin>
                           <Insets bottom="5.0" left="5.0" />
                        </HBox.margin></Button>
                        </HBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
