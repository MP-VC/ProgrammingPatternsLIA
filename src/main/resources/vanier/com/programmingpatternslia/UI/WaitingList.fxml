<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="589.0" minWidth="906.0" prefHeight="589.0" prefWidth="906.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vanier.com.programmingpatternslia.App.Controllers.WaitingListController">
    <children>
        <BorderPane styleClass="animated-background" stylesheets="@CSS/aniamtedbackground.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <left>
                <fx:include fx:id="sidebar" source="Sidebar.fxml" />
            </left>
            <center>
                <VBox spacing="18.0" alignment="TOP_LEFT">
                    <padding><Insets top="30.0" right="26.0" bottom="22.0" left="26.0" /></padding>
                    <children>
                        <Label fx:id="welcomeText" text="Waiting List" textFill="WHITE"><font><Font name="Arial Rounded MT Bold" size="24.0" /></font></Label>
                        <TableView VBox.vgrow="ALWAYS" stylesheets="@CSS/table.css" minHeight="100.0">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" /></columnResizePolicy>
                            <columns>
                                <TableColumn text="Conference" prefWidth="120.0" />
                                <TableColumn text="Position" prefWidth="120.0" />
                                <TableColumn text="Status" prefWidth="120.0" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Button mnemonicParsing="false" prefHeight="32.0" stylesheets="@CSS/stylizedbutton.css" text="Cancel" />
                        </HBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
