<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="ConferenceListAnchorPane" minHeight="589.0" minWidth="906.0" prefHeight="589.0" prefWidth="906.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vanier.com.programmingpatternslia.App.Controllers.ConfManagementController">
    <children>
        <BorderPane styleClass="animated-background" stylesheets="@CSS/aniamtedbackground.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <left>
                <fx:include fx:id="sidebar" source="Sidebar.fxml" />
            </left>
            <center>
                <VBox alignment="TOP_LEFT" spacing="18.0">
                    <padding><Insets bottom="22.0" left="26.0" right="26.0" top="30.0" /></padding>
                    <children>
                        <Label text="Conference Management" textFill="WHITE"><font><Font name="Arial Rounded MT Bold" size="24.0" /></font></Label>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <TextField fx:id="searchConfTextField" maxWidth="Infinity" onAction="#searchConferences" prefHeight="30.0" promptText="Search Conference" style="-fx-background-color: #0F0C0C; -fx-border-color: #C20000; -fx-background-radius: 5; -fx-border-radius: 5; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <TableView fx:id="conferencesTableView" stylesheets="@CSS/table.css" VBox.vgrow="ALWAYS">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" /></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="titleCol" prefWidth="150.0" text="Title" />
                                <TableColumn fx:id="dateCol" prefWidth="87.0" text="Date" />
                                <TableColumn fx:id="startTimeCol" prefWidth="51.5" text="Start" />
                                <TableColumn fx:id="endTimeCol" prefWidth="50.5" text="End" />
                                <TableColumn fx:id="capacityCol" prefWidth="57.5" text="Capacity" />
                                <TableColumn fx:id="availableSeatsCol" prefWidth="116.0" text="Available Seats" />
                                <TableColumn fx:id="locationCol" prefWidth="107.5" text="Location" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Button fx:id="viewConfButton" mnemonicParsing="false" onAction="#viewConferenceDetails" prefHeight="32.0" stylesheets="@CSS/stylizedbutton.css" text="View" />
                            <Button fx:id="editConfButton" mnemonicParsing="false" onAction="#editConference" prefHeight="32.0" stylesheets="@CSS/stylizedbutton.css" text="Edit" />
                            <Button fx:id="deleteConfButton" mnemonicParsing="false" onAction="#deleteConference" prefHeight="32.0" stylesheets="@CSS/stylizedbutton.css" text="Delete" />
                        </HBox>
                        <Label fx:id="homeLabel" managed="false" text="Home" visible="false" />
                        <Label fx:id="confLabel" managed="false" text="Conferences" visible="false" />
                        <Label fx:id="myRegistrationsLabel" managed="false" text="My Registrations" visible="false" />
                        <Label fx:id="waitingListLabel" managed="false" text="Waiting List" visible="false" />
                        <Label fx:id="profileLabel" managed="false" text="Profile" visible="false" />
                        <Label fx:id="confyRenceLabel" managed="false" text="ConfyRence" visible="false" />
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
